# Nicht geheime Einstellungen. Kennwörter liegen getrennt unter secrets/.
CLUBIQ_IMAGE=ghcr.io/rianflow/vereinskasse
CLUBIQ_IMAGE_TAG=latest
CLUBIQ_HOSTNAME=vereinskasse.local
TZ=Europe/Berlin

# Standard: interne PostgreSQL-Datenbank. Für einen verwalteten externen Host
# können diese vier Werte später geändert, POSTGRES_SSL=require,
# POSTGRES_SSL_MODE=verify-full und POSTGRES_SSL_ROOT_CERT=system gesetzt werden.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=vereinskasse
POSTGRES_USER=vereinskasse
POSTGRES_SSL=disable
POSTGRES_SSL_MODE=disable
POSTGRES_SSL_ROOT_CERT=

# Sicherungen: stündlich, danach verdichtet; 35 Tage lokal, 13 Monate auf USB.
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_DAYS=35
USB_RETENTION_DAYS=400
USB_BACKUP_PATH=/mnt/vereinskasse-sicherung

# Optional: verschlüsselte Außer-Haus-Sicherung in einem privaten Cloudflare-R2-Bucket.
CLUBIQ_R2_ENABLED=false
CLUBIQ_R2_ENDPOINT=
CLUBIQ_R2_BUCKET=
