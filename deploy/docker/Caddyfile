{
  admin off
  auto_https disable_redirects
  default_sni {$CLUBIQ_KIOSK_IP:10.42.0.1}
}

http://:8080 {
  @readerClock path /clubiq-time
  handle @readerClock {
    rewrite * /api/rfid/time
    reverse_proxy app:3000 {
      header_up Host {$CLUBIQ_HOSTNAME:vereinskasse.local}
      header_up X-Forwarded-Proto http
    }
    header Cache-Control "no-store"
  }

  @certificate path /vereinskasse-ca.crt /root.crt
  handle @certificate {
    rewrite * /root.crt
    root * /data/caddy/pki/authorities/local
    file_server
    header {
      Content-Type application/x-x509-ca-cert
      Content-Disposition "attachment; filename=clubiq-ledger-ca.crt"
      Cache-Control "no-store"
      X-Content-Type-Options "nosniff"
    }
  }

  respond 404
}

# Ausschliesslich auf dem Raspberry-Loopback veroeffentlicht. Tailscale Serve
# nutzt diesen Eingang fuer privaten HTTPS-Zugriff innerhalb des Tailnets.
http://:8090 {
  encode zstd gzip
  reverse_proxy app:3000 {
    header_up Host {$CLUBIQ_HOSTNAME:vereinskasse.local}
    header_up X-Forwarded-Host {$CLUBIQ_HOSTNAME:vereinskasse.local}
    header_up X-Forwarded-Proto https
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    -Server
  }
}

http://{$CLUBIQ_HOSTNAME:vereinskasse.local} {
  redir https://{$CLUBIQ_HOSTNAME:vereinskasse.local}{uri} permanent
}

https://{$CLUBIQ_HOSTNAME:vereinskasse.local}, https://{$CLUBIQ_LAN_IP:127.0.0.1}, https://{$CLUBIQ_KIOSK_IP:10.42.0.1} {
  tls internal
  encode zstd gzip
  @rfidCertificate path /rfid-ca.crt
  handle @rfidCertificate {
    rewrite * /root.crt
    root * /data/caddy/pki/authorities/local
    file_server
    header {
      Content-Type application/x-x509-ca-cert
      Content-Disposition "inline; filename=clubiq-ledger-ca.crt"
      Cache-Control "no-store"
      X-Content-Type-Options "nosniff"
    }
  }
  redir /wartung /wartung/ permanent
  handle_path /wartung/* {
    reverse_proxy host.docker.internal:8091 {
      header_up X-Forwarded-Proto https
    }
  }
  handle {
    reverse_proxy app:3000
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    -Server
  }
}
