{
  admin off
  auto_https disable_redirects
  default_sni {$CLUBIQ_LAN_IP:127.0.0.1}
}

http://:8080 {
  @certificate path /vereinskasse-ca.crt /root.crt
  rewrite @certificate /root.crt
  root * /data/caddy/pki/authorities/local
  file_server
  header {
    Content-Type application/x-x509-ca-cert
    Content-Disposition "attachment; filename=clubiq-ledger-ca.crt"
    Cache-Control "no-store"
    X-Content-Type-Options "nosniff"
  }
}

http://{$CLUBIQ_HOSTNAME:vereinskasse.local} {
  redir https://{$CLUBIQ_HOSTNAME:vereinskasse.local}{uri} permanent
}

https://{$CLUBIQ_HOSTNAME:vereinskasse.local}, https://{$CLUBIQ_LAN_IP:127.0.0.1} {
  tls internal
  encode zstd gzip
  reverse_proxy app:3000
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    -Server
  }
}
