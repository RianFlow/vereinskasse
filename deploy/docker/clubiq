#!/usr/bin/env bash
set -Eeuo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
base="$(cd "$(dirname "$self")" && pwd)"
compose=(docker compose --project-directory "$base" --env-file "$base/.env" -f "$base/compose.yaml")

require_installation() {
  [[ -f "$base/.env" && -d "$base/secrets" ]] || {
    echo "Clubiq Ledger ist noch nicht eingerichtet. Zuerst install.sh ausführen." >&2
    exit 1
  }
  command -v docker >/dev/null || { echo "Docker ist nicht installiert." >&2; exit 1; }
}

ensure_optional_secrets() {
  local secret
  for secret in r2_access_key_id r2_secret_access_key smtp_password; do
    [[ -f "$base/secrets/$secret" ]] || install -m 600 /dev/null "$base/secrets/$secret"
  done
}

wait_for_app() {
  local attempt hostname_setting
  hostname_setting="$(sed -n 's/^CLUBIQ_HOSTNAME=//p' "$base/.env" | tail -n 1)"
  hostname_setting="${hostname_setting:-vereinskasse.local}"
  for attempt in $(seq 1 60); do
    if curl --insecure --fail --silent --max-time 3 \
      --resolve "${hostname_setting}:443:127.0.0.1" \
      "https://${hostname_setting}/api/profiles" >/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

backup_path() {
  local value="$1"
  local usb_host
  usb_host="$(sed -n 's/^USB_BACKUP_PATH=//p' "$base/.env" | tail -n 1)"
  usb_host="${usb_host:-/mnt/vereinskasse-sicherung}"
  case "$value" in
    /backups/local/*|/backups/usb/*) printf '%s\n' "$value" ;;
    "$usb_host"/*) printf '/backups/usb/%s\n' "${value#"$usb_host"/}" ;;
    /*) echo "Pfad liegt außerhalb der eingebundenen Sicherungsziele." >&2; return 1 ;;
    *) printf '/backups/local/%s\n' "$value" ;;
  esac
}

set_setting() {
  local key="$1" value="$2" temporary
  temporary="$(mktemp)"
  awk -v key="$key" -v value="$value" '
    BEGIN { found=0 }
    $0 ~ "^" key "=" { print key "=" value; found=1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$base/.env" > "$temporary"
  install -m 600 "$temporary" "$base/.env"
  rm -f "$temporary"
}

current_lan_ip() {
  ip -4 -o address show dev eth0 scope global 2>/dev/null | awk '{ split($4,address,"/"); print address[1]; exit }'
}

setting() {
  local key="$1"
  sed -n "s/^${key}=//p" "$base/.env" | tail -n 1
}

kiosk_wifi_interface() {
  local interface
  interface="$(setting CLUBIQ_KIOSK_WIFI_INTERFACE)"
  printf '%s\n' "${interface:-wlan0}"
}

kiosk_wifi_status() {
  local interface connection
  interface="$(kiosk_wifi_interface)"
  connection="$(nmcli --terse --fields GENERAL.CONNECTION device show "$interface" 2>/dev/null | cut -d: -f2- || true)"
  echo "Kassen-WLAN: ${connection:-(nicht aktiv)}"
  if [[ "$connection" == "clubiq-kassen-wlan" ]]; then
    nmcli --terse --fields GENERAL.DEVICE,GENERAL.STATE,IP4.ADDRESS device show "$interface" 2>/dev/null || true
  fi
  if ip -4 -o address show dev eth0 scope global >/dev/null 2>&1; then
    echo "Internetweg: LAN verbunden ($(current_lan_ip))"
  else
    echo "Internetweg: kein LAN; die lokale Kasse funktioniert, Fernzugriff und Cloud-Dienste warten"
  fi
}

tailscale_serve_was_active=false

pause_tailscale_serve() {
  local serve_status
  tailscale_serve_was_active=false
  command -v tailscale >/dev/null 2>&1 || return 0
  serve_status="$(tailscale serve status 2>/dev/null || true)"
  [[ "$serve_status" == *"http://127.0.0.1:8090"* ]] || return 0
  tailscale_serve_was_active=true
  echo "Tailscale-Fernzugriff wird fuer den Proxy-Neustart kurz pausiert."
  tailscale serve --https=443 off >/dev/null
}

resume_tailscale_serve() {
  [[ "$tailscale_serve_was_active" == true ]] || return 0
  tailscale serve --bg http://127.0.0.1:8090 >/dev/null || {
    echo "Hinweis: Tailscale-Fernzugriff konnte nicht automatisch reaktiviert werden." >&2
    echo "Erneut aktivieren mit: sudo clubiq fernzugriff-einrichten" >&2
    return 0
  }
  echo "Tailscale-Fernzugriff ist wieder aktiv."
}

compose_with_tailscale_paused() {
  local command_status=0
  pause_tailscale_serve
  "$@" || command_status=$?
  resume_tailscale_serve
  return "$command_status"
}

show_help() {
  cat <<'HELP'
Clubiq Ledger auf dem Raspberry verwalten

  clubiq starten                 Kasse starten
  clubiq stoppen                 Kasse kontrolliert stoppen
  clubiq status                  Zustand und letzte Sicherung anzeigen
  clubiq protokoll               Laufende Meldungen anzeigen
  clubiq sichern                 Sofort eine geprüfte Sicherung erstellen
  clubiq sicherungen             Vorhandene Sicherungen auflisten
  clubiq pruefen                 Datenbank und Anwendung prüfen
  clubiq aktualisieren           Sicherung, Update und automatischer Rückfall
  clubiq wiederherstellen DATEI  Sicherung erst prüfen, dann zurückspielen
  clubiq neue-datenbank          Nach Tests sauber und leer beginnen
  clubiq kassen-wlan-einrichten  Festes 2,4-GHz-WLAN fuer Tablet und RFID einrichten
  clubiq kassen-wlan-status      Kassen-WLAN und LAN-Uplink anzeigen
  clubiq rfid-netz-pruefen       WLAN, Uhrzeit, Zertifikat und RFID-API gemeinsam pruefen
  clubiq wartung-einrichten      Unabhaengiges lokales Wartungsportal aktivieren
  clubiq wartung-status          Adresse und Dienstzustand des Wartungsportals anzeigen
  clubiq netzwerk-aktualisieren  Aktuelle LAN-IP für Tablet-Zugriff übernehmen
  clubiq usb-freigeben [PFAD]    Bereits eingehängten USB-Datenträger freigeben
  clubiq r2-einrichten           Verschlüsselte Cloudflare-R2-Kopie einrichten
  clubiq r2-pruefen              R2-Sicherung sofort testen
  clubiq r2-laden [SNAPSHOT]     Letztes R2-Archiv lokal bereitstellen
  clubiq email-einrichten        SMTP-Zugang fuer Rechnungs-E-Mails einrichten
  clubiq email-pruefen           Verbindung zum Mailserver testen (ohne Versand)
  clubiq fernzugriff-einrichten  Privaten HTTPS-Zugang ueber Tailscale aktivieren
  clubiq fernzugriff-status      Adresse und Zustand des Fernzugriffs anzeigen
  clubiq zertifikat              Adresse des Tablet-Zertifikats anzeigen
HELP
}

require_installation
ensure_optional_secrets
command="${1:-hilfe}"

case "$command" in
  hilfe|help|-h|--help)
    show_help
    ;;
  starten|start)
    compose_with_tailscale_paused "${compose[@]}" up -d --remove-orphans
    wait_for_app || { echo "Die Kasse wurde gestartet, ist aber noch nicht erreichbar." >&2; exit 1; }
    echo "Clubiq Ledger ist erreichbar."
    ;;
  stoppen|stop)
    "${compose[@]}" stop
    ;;
  status)
    "${compose[@]}" ps
    echo
    echo "Speicherplatz:"
    df -h "$base" | tail -n 1
    usb_path="$(sed -n 's/^USB_BACKUP_PATH=//p' "$base/.env" | tail -n 1)"
    if [[ -n "$usb_path" ]] && findmnt --mountpoint "$usb_path" >/dev/null 2>&1; then
      echo "USB-Ziel: eingehängt ($usb_path)"
      df -h "$usb_path" | tail -n 1
    else
      echo "USB-Ziel: noch nicht als eigener Datenträger eingehängt"
    fi
    echo
    echo "Letzte lokale Sicherung:"
    "${compose[@]}" exec -T backup sh -c 'cat /backups/local/.last-backup.json 2>/dev/null || echo "noch keine"'
    echo "Letzte R2-Sicherung:"
    "${compose[@]}" exec -T backup sh -c 'cat /backups/local/.last-r2-backup.json 2>/dev/null || echo "nicht eingerichtet"'
    echo
    if command -v nmcli >/dev/null 2>&1; then kiosk_wifi_status; else echo "Kassen-WLAN: NetworkManager noch nicht installiert"; fi
    ;;
  protokoll|logs)
    "${compose[@]}" logs --tail=200 -f app postgres proxy backup
    ;;
  sichern|backup)
    backup_started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    "${compose[@]}" exec -T backup /app/deploy/raspberry/backup.sh
    backup_finished="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    "${compose[@]}" exec -T backup sh -c \
      'printf '\''{"ok":true,"startedAt":"%s","finishedAt":"%s"}\n'\'' "$1" "$2" > /backups/local/.last-backup.json' \
      _ "$backup_started" "$backup_finished"
    ;;
  sicherungen|backups)
    "${compose[@]}" exec -T backup sh -c \
      'find /backups/local /backups/usb -maxdepth 1 -type f -name "vereinskasse-*.tar.gz" -printf "%TY-%Tm-%Td %TH:%TM  %10s  %p\n" 2>/dev/null | sort -r'
    ;;
  pruefen|check)
    "${compose[@]}" run --rm tools node raspberry/postgres-admin.mjs check
    latest_archive="$("${compose[@]}" exec -T backup sh -c \
      "find /backups/local -maxdepth 1 -type f -name 'vereinskasse-*.tar.gz' -printf '%T@ %p\\n' | sort -nr | head -n 1 | cut -d' ' -f2-")"
    if [[ -n "$latest_archive" ]]; then
      "${compose[@]}" run --rm tools /app/deploy/docker/restore.sh "$latest_archive" --preview
    else
      echo "Noch keine Sicherung zum Rücksicherungstest vorhanden." >&2
    fi
    wait_for_app
    echo "Datenbank, Anwendung und jüngste Sicherung sind geprüft."
    ;;
  aktualisieren|update)
    "${compose[@]}" exec -T backup /app/deploy/raspberry/backup.sh
    container_id="$("${compose[@]}" ps -q app)"
    [[ -n "$container_id" ]] || { echo "App-Container wurde nicht gefunden." >&2; exit 1; }
    image_ref="$(docker inspect --format '{{.Config.Image}}' "$container_id")"
    old_image="$(docker inspect --format '{{.Image}}' "$container_id")"
    rollback_ref="${image_ref}-rollback"
    docker tag "$old_image" "$rollback_ref"
    "${compose[@]}" pull app backup tools proxy postgres
    compose_with_tailscale_paused "${compose[@]}" up -d --remove-orphans
    if wait_for_app; then
      echo "Update erfolgreich; Datenbank und Sicherungen sind erhalten."
    else
      echo "Neue Version ist nicht gesund. Vorherige App-Version wird wiederhergestellt." >&2
      docker tag "$rollback_ref" "$image_ref"
      "${compose[@]}" up -d --force-recreate app backup
      wait_for_app || { echo "Automatischer Rückfall fehlgeschlagen; Protokoll prüfen." >&2; exit 1; }
      exit 1
    fi
    ;;
  wiederherstellen|restore)
    [[ -n "${2:-}" ]] || { echo "Bitte eine Sicherungsdatei angeben." >&2; exit 2; }
    archive="$(backup_path "$2")"
    "${compose[@]}" run --rm tools /app/deploy/docker/restore.sh "$archive" --preview
    read -r -p "Soll dieser geprüfte Stand wirklich aktiviert werden? Exakt WIEDERHERSTELLEN eingeben: " confirmation
    [[ "$confirmation" == "WIEDERHERSTELLEN" ]] || { echo "Abgebrochen."; exit 1; }
    "${compose[@]}" exec -T backup /app/deploy/raspberry/backup.sh
    "${compose[@]}" stop app backup
    restart_after_restore() { "${compose[@]}" up -d app backup proxy >/dev/null 2>&1 || true; }
    trap restart_after_restore EXIT
    "${compose[@]}" run --rm -e CLUBIQ_RESTORE_CONFIRMED=WIEDERHERSTELLEN tools \
      /app/deploy/docker/restore.sh "$archive" --execute
    "${compose[@]}" up -d app backup proxy
    trap - EXIT
    wait_for_app
    echo "Wiederherstellung abgeschlossen und Anwendung geprüft."
    ;;
  neue-datenbank|new-database)
    "${compose[@]}" exec -T backup /app/deploy/raspberry/backup.sh
    "${compose[@]}" stop app backup
    restart_after_reset() { "${compose[@]}" up -d app backup proxy >/dev/null 2>&1 || true; }
    trap restart_after_reset EXIT
    "${compose[@]}" run --rm tools /app/deploy/docker/new-database.sh
    "${compose[@]}" up -d app backup proxy
    trap - EXIT
    wait_for_app
    ;;
  kassen-wlan-einrichten|kiosk-wifi-setup)
    [[ "${EUID:-$(id -u)}" -eq 0 ]] || { echo "Bitte mit sudo ausfuehren." >&2; exit 1; }
    allow_without_lan=false
    [[ "${2:-}" == "--ohne-lan" ]] && allow_without_lan=true
    if ! ip -4 -o address show dev eth0 scope global >/dev/null 2>&1 && [[ "$allow_without_lan" != true ]]; then
      echo "Vor der Umstellung bitte ein LAN-Kabel anschliessen. Sonst kann die laufende SSH-Verbindung abbrechen." >&2
      echo "Direkt am Raspberry ist alternativ moeglich: sudo clubiq kassen-wlan-einrichten --ohne-lan" >&2
      exit 1
    fi
    if ! command -v nmcli >/dev/null 2>&1; then
      echo "NetworkManager wird fuer das feste Kassen-WLAN installiert."
      apt-get update
      apt-get install --yes network-manager
    fi
    systemctl enable --now NetworkManager
    interface="$(kiosk_wifi_interface)"
    nmcli device status | awk -v interface="$interface" '$1==interface && $2=="wifi" { found=1 } END { exit found?0:1 }' || {
      echo "WLAN-Schnittstelle $interface wurde nicht gefunden." >&2
      exit 1
    }
    default_ssid="$(setting CLUBIQ_KIOSK_WIFI_SSID)"
    default_ssid="${default_ssid:-ClubIQ-Kasse}"
    read -r -p "Name des Kassen-WLANs [$default_ssid]: " kiosk_ssid
    kiosk_ssid="${kiosk_ssid:-$default_ssid}"
    [[ "$kiosk_ssid" =~ ^[A-Za-z0-9._-]{3,32}$ ]] || {
      echo "Der WLAN-Name darf nur Buchstaben, Zahlen, Punkt, Unterstrich und Bindestrich enthalten." >&2
      exit 1
    }
    while true; do
      read -r -s -p "Neues Kassen-WLAN-Kennwort (12 bis 63 Zeichen): " kiosk_password
      echo
      read -r -s -p "Kennwort wiederholen: " kiosk_password_repeat
      echo
      [[ "$kiosk_password" == "$kiosk_password_repeat" && ${#kiosk_password} -ge 12 && ${#kiosk_password} -le 63 ]] && break
      echo "Die Kennwoerter muessen gleich sein und 12 bis 63 Zeichen haben."
    done
    country="$(setting CLUBIQ_KIOSK_WIFI_COUNTRY)"
    country="${country:-DE}"
    command -v rfkill >/dev/null 2>&1 && rfkill unblock wifi || true
    command -v iw >/dev/null 2>&1 && iw reg set "$country" || true
    nmcli radio wifi on
    nmcli device set "$interface" managed yes
    if nmcli --terse --fields NAME connection show | grep -Fxq "clubiq-kassen-wlan"; then
      nmcli connection modify clubiq-kassen-wlan connection.interface-name "$interface" 802-11-wireless.ssid "$kiosk_ssid"
    else
      nmcli connection add type wifi ifname "$interface" con-name clubiq-kassen-wlan ssid "$kiosk_ssid"
    fi
    nmcli connection modify clubiq-kassen-wlan \
      connection.autoconnect yes connection.autoconnect-priority 100 connection.autoconnect-retries 0 \
      802-11-wireless.mode ap 802-11-wireless.band bg 802-11-wireless.channel 6 802-11-wireless.powersave 2 \
      802-11-wireless-security.key-mgmt wpa-psk 802-11-wireless-security.proto rsn \
      802-11-wireless-security.pairwise ccmp 802-11-wireless-security.psk "$kiosk_password" \
      ipv4.method shared ipv4.addresses 10.42.0.1/24 ipv4.never-default yes ipv6.method disabled
    install -m 600 /dev/null "$base/secrets/kiosk_wifi_password"
    printf '%s' "$kiosk_password" > "$base/secrets/kiosk_wifi_password"
    unset kiosk_password kiosk_password_repeat
    set_setting CLUBIQ_KIOSK_IP 10.42.0.1
    set_setting CLUBIQ_KIOSK_WIFI_INTERFACE "$interface"
    set_setting CLUBIQ_KIOSK_WIFI_SSID "$kiosk_ssid"
    set_setting CLUBIQ_KIOSK_WIFI_COUNTRY "$country"
    nmcli --wait 30 connection up clubiq-kassen-wlan ifname "$interface"
    ip -4 -o address show dev "$interface" | grep -q '10\.42\.0\.1/24' || {
      echo "Das Kassen-WLAN wurde angelegt, aber die feste Adresse 10.42.0.1 fehlt." >&2
      exit 1
    }
    compose_with_tailscale_paused "${compose[@]}" up -d --force-recreate app proxy
    wait_for_app || { echo "Das WLAN steht, aber die Kasse ist noch nicht erreichbar." >&2; exit 1; }
    echo "Kassen-WLAN ist bereit: $kiosk_ssid"
    echo "Tablet und RFID-Leser einmal damit verbinden."
    echo "Kasse: https://10.42.0.1"
    echo "Zertifikat: http://10.42.0.1:8080/vereinskasse-ca.crt"
    ;;
  kassen-wlan-status|kiosk-wifi-status)
    command -v nmcli >/dev/null 2>&1 || { echo "NetworkManager ist nicht installiert." >&2; exit 1; }
    kiosk_wifi_status
    ;;
  rfid-netz-pruefen|rfid-network-check)
    command -v nmcli >/dev/null 2>&1 || { echo "NetworkManager ist nicht installiert." >&2; exit 1; }
    kiosk_ip="$(setting CLUBIQ_KIOSK_IP)"
    kiosk_ip="${kiosk_ip:-10.42.0.1}"
    connection="$(nmcli --terse --fields GENERAL.CONNECTION device show "$(kiosk_wifi_interface)" 2>/dev/null | cut -d: -f2- || true)"
    [[ "$connection" == "clubiq-kassen-wlan" ]] || { echo "Das Kassen-WLAN ist nicht aktiv." >&2; exit 1; }
    nmcli --get-values 802-11-wireless.band connection show clubiq-kassen-wlan | grep -qx 'bg' || {
      echo "Das Kassen-WLAN ist nicht fest auf 2,4 GHz eingestellt." >&2
      exit 1
    }
    ca_file="$(mktemp)"
    response_file="$(mktemp)"
    cleanup_rfid_check() { rm -f "$ca_file" "$response_file"; }
    trap cleanup_rfid_check EXIT
    curl --fail --silent --show-error --max-time 5 "http://${kiosk_ip}:8080/vereinskasse-ca.crt" --output "$ca_file"
    grep -q 'BEGIN CERTIFICATE' "$ca_file" || { echo "Das RFID-Root-Zertifikat ist ungueltig." >&2; exit 1; }
    epoch="$(curl --fail --silent --show-error --max-time 5 "http://${kiosk_ip}:8080/clubiq-time")"
    [[ "$epoch" =~ ^[0-9]{10}$ && "$epoch" -gt 1700000000 ]] || { echo "Der lokale Zeitdienst antwortet nicht korrekt." >&2; exit 1; }
    http_status="$(curl --cacert "$ca_file" --silent --show-error --max-time 8 --output "$response_file" --write-out '%{http_code}' "https://${kiosk_ip}/api/rfid/health")"
    [[ "$http_status" == "401" ]] || {
      echo "Die sichere RFID-API antwortet unerwartet mit HTTP $http_status." >&2
      cat "$response_file" >&2
      exit 1
    }
    trap - EXIT
    cleanup_rfid_check
    echo "RFID-Netzweg geprueft: 2,4-GHz-Kassen-WLAN, lokale Uhrzeit, TLS-Zertifikat und RFID-API sind erreichbar."
    ;;
  wartung-einrichten|maintenance-setup)
    [[ "${EUID:-$(id -u)}" -eq 0 ]] || { echo "Bitte mit sudo ausfuehren." >&2; exit 1; }
    "$base/../maintenance/install.sh"
    ;;
  wartung-status|maintenance-status)
    systemctl --no-pager --full status clubiq-maintenance.service || true
    echo "Wartungsportal: https://10.42.0.1/wartung/"
    echo "Notfallzugang ohne E-Mail-Konfiguration: http://10.42.0.1:8091"
    ;;
  netzwerk-aktualisieren|network-refresh)
    lan_ip="$(current_lan_ip)"
    [[ -n "$lan_ip" ]] || { echo "Keine lokale IPv4-Adresse gefunden." >&2; exit 1; }
    set_setting CLUBIQ_LAN_IP "$lan_ip"
    compose_with_tailscale_paused "${compose[@]}" up -d --force-recreate app proxy
    wait_for_app || { echo "Die Kasse wurde aktualisiert, ist aber noch nicht erreichbar." >&2; exit 1; }
    echo "Aktuelle LAN-IP übernommen: $lan_ip"
    echo "Kasse per IP: https://$lan_ip"
    ;;
  usb-freigeben|usb-enable)
    target="${2:-$(sed -n 's/^USB_BACKUP_PATH=//p' "$base/.env" | tail -n 1)}"
    target="${target:-/mnt/vereinskasse-sicherung}"
    [[ -d "$target" ]] || { echo "Verzeichnis $target existiert nicht." >&2; exit 1; }
    mount_target="$(findmnt --noheadings --output TARGET --target "$target" | head -n 1)"
    [[ "$(realpath "$mount_target")" == "$(realpath "$target")" && "$mount_target" != "/" ]] || {
      echo "$target ist kein eigenständig eingehängter Datenträger. Aus Sicherheitsgründen nicht freigegeben." >&2
      exit 1
    }
    touch "$target/.clubiq-backup-target"
    chmod 600 "$target/.clubiq-backup-target" 2>/dev/null || true
    set_setting USB_BACKUP_PATH "$target"
    "${compose[@]}" up -d --force-recreate backup
    echo "USB-Sicherungsziel freigegeben: $target"
    ;;
  r2-einrichten|r2-setup)
    read -r -p "R2-Endpunkt (https://...r2.cloudflarestorage.com): " endpoint
    read -r -p "Privater R2-Bucket: " bucket
    read -r -p "Access Key ID: " access_key
    read -r -s -p "Secret Access Key: " secret_key
    echo
    [[ "$endpoint" =~ ^https://[A-Za-z0-9.-]+\.r2\.cloudflarestorage\.com$ ]] || { echo "Ungültiger R2-Endpunkt." >&2; exit 1; }
    [[ "$bucket" =~ ^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$ ]] || { echo "Ungueltiger R2-Bucket. Erlaubt sind 3 bis 63 Kleinbuchstaben, Zahlen und Bindestriche." >&2; exit 1; }
    [[ -n "$access_key" && -n "$secret_key" ]] || { echo "R2-Zugangsdaten duerfen nicht leer sein." >&2; exit 1; }
    printf '%s' "$access_key" > "$base/secrets/r2_access_key_id"
    printf '%s' "$secret_key" > "$base/secrets/r2_secret_access_key"
    chmod 600 "$base/secrets/r2_access_key_id" "$base/secrets/r2_secret_access_key"
    set_setting CLUBIQ_R2_ENDPOINT "$endpoint"
    set_setting CLUBIQ_R2_BUCKET "$bucket"
    set_setting CLUBIQ_R2_ENABLED true
    "${compose[@]}" up -d --force-recreate backup
    echo "R2 ist eingerichtet. Der Inhalt wird mit dem separaten Restic-Schlüssel verschlüsselt."
    echo "Diesen Schlüssel zusätzlich offline verwahren: $base/secrets/restic_password"
    ;;
  r2-pruefen|r2-check)
    "${compose[@]}" exec -T backup /app/deploy/docker/r2-backup.sh
    ;;
  r2-laden|r2-restore)
    "${compose[@]}" exec -T backup /app/deploy/docker/r2-restore-latest.sh "${2:-latest}"
    ;;
  email-einrichten|email-setup)
    read -r -p "SMTP-Server (z. B. smtp.gmail.com): " smtp_host
    read -r -p "SMTP-Port [587]: " smtp_port
    smtp_port="${smtp_port:-587}"
    read -r -p "Sicherheit [starttls/tls, Standard starttls]: " smtp_security
    smtp_security="${smtp_security:-starttls}"
    read -r -p "SMTP-Benutzername: " smtp_user
    read -r -s -p "SMTP-Passwort oder App-Passwort: " smtp_password
    echo
    read -r -p "Absender-E-Mail: " smtp_sender
    read -r -p "Antwortadresse (leer = Absender): " smtp_reply
    [[ "$smtp_host" =~ ^[A-Za-z0-9.-]+$ ]] || { echo "Ungueltiger SMTP-Server." >&2; exit 1; }
    [[ "$smtp_port" =~ ^[0-9]+$ && "$smtp_port" -ge 1 && "$smtp_port" -le 65535 ]] || { echo "Ungueltiger SMTP-Port." >&2; exit 1; }
    [[ "$smtp_security" == "starttls" || "$smtp_security" == "tls" ]] || { echo "Sicherheit muss starttls oder tls sein." >&2; exit 1; }
    [[ -n "$smtp_user" && -n "$smtp_password" ]] || { echo "SMTP-Zugangsdaten duerfen nicht leer sein." >&2; exit 1; }
    [[ "$smtp_sender" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || { echo "Ungueltige Absender-E-Mail." >&2; exit 1; }
    [[ -z "$smtp_reply" || "$smtp_reply" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || { echo "Ungueltige Antwortadresse." >&2; exit 1; }
    printf '%s' "$smtp_password" > "$base/secrets/smtp_password"
    chmod 600 "$base/secrets/smtp_password"
    set_setting CLUBIQ_SMTP_HOST "$smtp_host"
    set_setting CLUBIQ_SMTP_PORT "$smtp_port"
    set_setting CLUBIQ_SMTP_SECURITY "$smtp_security"
    set_setting CLUBIQ_SMTP_USER "$smtp_user"
    set_setting CLUBIQ_SMTP_FROM "Clubiq Ledger <$smtp_sender>"
    set_setting CLUBIQ_SMTP_REPLY_TO "${smtp_reply:-$smtp_sender}"
    unset smtp_password
    "${compose[@]}" up -d --no-deps --force-recreate app
    wait_for_app || { echo "Die Kasse ist nach der E-Mail-Einrichtung nicht erreichbar." >&2; exit 1; }
    "${compose[@]}" exec -T app node /app/raspberry/smtp-check.mjs
    ;;
  email-pruefen|email-check)
    "${compose[@]}" exec -T app node /app/raspberry/smtp-check.mjs
    ;;
  fernzugriff-einrichten|remote-access-setup)
    command -v tailscale >/dev/null || {
      echo "Tailscale ist nicht installiert. Zuerst Tailscale auf dem Raspberry einrichten." >&2
      exit 1
    }
    tailscale_ip="$(tailscale ip -4 2>/dev/null | head -n 1)"
    [[ -n "$tailscale_ip" ]] || {
      echo "Der Raspberry ist noch nicht bei Tailscale angemeldet. Zuerst 'sudo tailscale up' ausfuehren." >&2
      exit 1
    }
    compose_with_tailscale_paused "${compose[@]}" up -d --force-recreate proxy
    for attempt in $(seq 1 30); do
      if curl --fail --silent --max-time 3 http://127.0.0.1:8090/api/profiles >/dev/null; then
        break
      fi
      [[ "$attempt" -lt 30 ]] || {
        echo "Der private App-Eingang auf 127.0.0.1:8090 ist nicht erreichbar." >&2
        exit 1
      }
      sleep 1
    done
    tailscale serve --bg http://127.0.0.1:8090
    echo "Privater Fernzugriff ist aktiviert. Er ist nur fuer angemeldete Tailscale-Geraete erreichbar:"
    tailscale serve status
    ;;
  fernzugriff-status|remote-access-status)
    command -v tailscale >/dev/null || {
      echo "Tailscale ist nicht installiert." >&2
      exit 1
    }
    tailscale serve status
    ;;
  zertifikat|certificate)
    ip="$(current_lan_ip)"
    kiosk_ip="$(setting CLUBIQ_KIOSK_IP)"
    kiosk_ip="${kiosk_ip:-10.42.0.1}"
    echo "Kassen-WLAN-Zertifikat: http://${kiosk_ip}:8080/vereinskasse-ca.crt"
    echo "Kassen-WLAN: https://${kiosk_ip}"
    echo "Tablet-Zertifikat: http://${ip:-RASPBERRY-IP}:8080/vereinskasse-ca.crt"
    echo "Kasse: https://$(sed -n 's/^CLUBIQ_HOSTNAME=//p' "$base/.env" | tail -n 1)"
    echo "Kasse per IP: https://$(sed -n 's/^CLUBIQ_LAN_IP=//p' "$base/.env" | tail -n 1)"
    ;;
  *)
    echo "Unbekannter Befehl: $command" >&2
    show_help
    exit 2
    ;;
esac
