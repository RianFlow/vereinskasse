[Unit]
Description=SV Barver Vereinskasse
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=vereinskasse
Group=vereinskasse
WorkingDirectory=/opt/vereinskasse/current
EnvironmentFile=/etc/vereinskasse/environment
ExecStart=/usr/local/bin/node raspberry/run-with-runtime.mjs start
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vereinskasse

[Install]
WantedBy=multi-user.target
