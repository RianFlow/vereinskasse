    "check:raspberry": "node raspberry/check-local-runtime.mjs",
    "db:postgres:migrate": "node raspberry/postgres-admin.mjs migrate",
    "db:postgres:bootstrap": "node raspberry/postgres-admin.mjs bootstrap",
    "db:postgres:check": "node raspberry/postgres-admin.mjs check",
    "test": "npm run check:migrations && npm run typecheck && npm run build && node --test tests/rendered-html.test.mjs tests/event-dialog.test.mjs tests/bundles.test.mjs tests/futureproof.test.mjs tests/allocation.test.mjs tests/i2c-display.test.mjs tests/safety-workflows.test.mjs tests/rfid-resilience.test.mjs tests/retail-pos-design.test.mjs tests/raspberry-hosting.test.mjs tests/postgres-runtime.test.mjs tests/docker-deployment.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.45.0",
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "2.4.0",
